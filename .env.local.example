# Base URL of this deployment — used for email confirmation redirects and
# the Paystack checkout callback. Update to the production URL when deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: used for privileged operations (report generation, admin tasks).
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only: direct Postgres connection, used by scripts/apply-migration.mjs
# to run SQL migrations. Never expose this to the browser.
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# MapTiler (free tier) - https://cloud.maptiler.com/account/keys/
NEXT_PUBLIC_MAPTILER_KEY=your-maptiler-key

# Paystack (use TEST mode keys for development — https://dashboard.paystack.com/#/settings/developer)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your-public-key
PAYSTACK_SECRET_KEY=sk_test_your-secret-key
